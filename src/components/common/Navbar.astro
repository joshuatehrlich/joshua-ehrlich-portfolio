---
// Common navigation for all pages
import '../../styles/navbar.scss';

import InstagramLogo from '../../assets/logos/instagram.svg';
import XLogo from '../../assets/logos/x.svg';
import ItchLogo from '../../assets/logos/itchdotio.svg';
import ArtstationLogo from '../../assets/logos/artstation.svg';
---
<script src="../../scripts/navbar.js"></script>

<nav class="navbar">
  <img src="/images/signature.png" class="signature"/>
  <div class="title-section">
    <a href="/">
      <h1>Joshua Ehrlich</h1>
      <h3>game designer and illustrator</h3>
    </a>
  </div>
  
  <ul class="nav-links">
    <ul class="games">
      <li><a href="/dust">Dust</a></li>
      <li><a href="/bladebearer">Blade Bearer</a></li>
      <!-- <li><a href="/earthen">Earthen</a></li>
      <li><a href="/game-jams">Name That!</a></li> -->
    </ul>
    <ul class="mics">
      <li><a href="/illustration">Illustration</a></li>
      <li><a href="/comics">Comics</a></li>
      <li><a href="/animation">Animation</a></li>
    </ul>
    <ul class="websites">
      <li><a href="/abeatingheart">abeatinghe.art</a></li>
      <li><a href="/itshouldendat">it should end at</a></li>
      <li><a href="/terrain">inner world</a></li>
    </ul>
    <ul class="info">
      <li><a href="/about">About</a></li>
    </ul>
  </ul>
  <div class="social-links">
    <a href="https://instagram.com/joshuatehrlich" target="_blank">
      <img src={InstagramLogo.src} alt="Instagram" class="social-logo" />
    </a>
    <a href="https://x.com/joshuatehrlich" target="_blank">
      <img src={XLogo.src} alt="X" class="social-logo" />
    </a>
    <a href="https://lukko.digital" target="_blank">
      <img src={ItchLogo.src} alt="Itch.io" class="social-logo" />
    </a>
    <a href="https://www.artstation.com/tobiiarts" target="_blank">
      <img src={ArtstationLogo.src} alt="Artstation" class="social-logo" />
    </a>
  </div>
</nav>


