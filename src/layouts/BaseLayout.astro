---
import BaseHead from '../components/common/BaseHead.astro';
import Navbar from '../components/common/Navbar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <div class="page-container">
      <!-- Left sidebar (1/4) - Common navbar for all pages -->
      <aside class="sidebar">
        <Navbar />
      </aside>

      <div class="sidebar-spacer"></div>
      
      <!-- Right content (3/4) - Page-specific content -->
      <main class="content">
        <slot />
      </main>
    </div>
  </body>
</html>

<style lang="scss">
  .page-container {
    display: flex;
    min-height: 100vh;
    gap: 0;
  }

  :root {
    --sidebar-width: 25rem;
  }
  
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    background: var(--bg-light);
    border-right: 1.5px solid var(--border-color);
    // box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.211);
    padding: 3.5rem;
    overflow-y: auto;
    z-index: 100;
    // display:none;
    // opacity: 0.4;
  }

  .sidebar-spacer {
    width: var(--sidebar-width);
    height: 100%;
    // min-width: 22rem;
    // background: var(--bg-light);
    flex-shrink: 0;
    background-color: red;
    z-index: 100;
  }
  
  .content {
    // margin-left: 20%;
    width: 100%;
    flex-shrink: 1;
    background: var(--bg-dark);
    padding: 0;
    min-height: 100vh;

    &::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      // box-shadow: inset 20px 0px 20px rgba(0, 0, 0, 0.699);
    }
  }
  
  @media (max-width: 768px) {
    .sidebar {
      position: relative;
      width: 100%;
      height: auto;
      min-width: auto;
      border-right: none;
      border-bottom: 1px solid var(--border-color);
    }
    
    .content {
      margin-left: 0;
      min-width: auto;
    }
  }
</style>

