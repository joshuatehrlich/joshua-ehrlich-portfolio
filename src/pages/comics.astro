---
import BaseLayout from '../layouts/BaseLayout.astro';
import SlideshowLayout from '../components/SlideshowLayout.astro';
import { editorialArtwork } from '../data/editorial';
import { conceptArtArtwork } from '../data/concept-art';
import { illustrationArtwork } from '../data/illustration';
import { SITE_TITLE } from '../consts';
import '../styles/illustration.scss';

// Single configuration - just add/remove entries here
// Each entry maps to: key -> { label, artwork }
const CATEGORIES = [
  { key: 'illustration', label: 'Illustration', artwork: illustrationArtwork },
  { key: 'concept-art', label: 'Concept Art', artwork: conceptArtArtwork },
  { key: 'editorial', label: 'Editorial', artwork: editorialArtwork }
];

// Get category from URL params, default to first category
const url = new URL(Astro.request.url);
const categoryParam = url.searchParams.get('category');
const currentCategoryKey = categoryParam || CATEGORIES[0].key;

// Find the current category config and get its artwork
const currentCategory = CATEGORIES.find(cat => cat.key === currentCategoryKey) || CATEGORIES[0];
const artwork = currentCategory.artwork;

console.log('Current category:', currentCategoryKey);
---

<BaseLayout title={`Comics - ${SITE_TITLE}`} description="A collection of comics and artwork">
  <div class="illustration-page">
    <div class="category-selector">
      {CATEGORIES.map((cat, index) => (
        <>
          <span 
            class={`category-option ${currentCategoryKey === cat.key ? 'active' : ''}`} 
            data-category={cat.key}
          >
            {cat.label}
          </span>
          {index < CATEGORIES.length - 1 && (
            <span class="category-separator">•</span>
          )}
        </>
      ))}
    </div>

    <div class="slideshow-container">
      <SlideshowLayout artwork={artwork} />
    </div>
  </div>
</BaseLayout>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    const categoryOptions = document.querySelectorAll('.category-option');
    
    // Get current category from URL for debugging
    const url = new URL(window.location.href);
    const currentCategory = url.searchParams.get('category');
    console.log('Current category from URL:', currentCategory);
    
    categoryOptions.forEach(option => {
      option.addEventListener('click', () => {
        const element = option as HTMLElement;
        const category = element.dataset.category;
        
        const url = new URL(window.location.href);
        url.searchParams.set('category', category || 'illustration');
        window.location.href = url.toString();
      });
    });
  });
</script>
