---
import GalleryLayout from '../components/GalleryLayout.astro';
import { conceptArtArtwork } from '../data/concept-art';

// Concept art gallery row configuration
const conceptArtRows = [
  {
    id: 'row1',
    height: '300px',
    imageIds: ['dragon', 'perst_canyon'],
    flexShrink: [1, 2]
  },
  {
    id: 'row2', 
    height: '320px',
    imageIds: ['sketch_3', 'sketch_4'],
    flexShrink: [1, 1]
  },
  {
    id: 'row3',
    height: '280px',
    imageIds: ['abstract', 'mask', 'panel'],
    flexShrink: [1, 1, 1]
  }
];
---

<GalleryLayout 
  title="Concept Art"
  description="Character designs, environments, and concept artwork"
  artwork={conceptArtArtwork}
  rows={conceptArtRows}
  imageFolder="illustration"
/>