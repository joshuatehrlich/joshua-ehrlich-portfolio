---
import BaseLayout from '../layouts/BaseLayout.astro';
import SlideshowVariableLayout from '../components/SlideshowVariableLayout.astro';
import { loadAllArtworkCollections } from '../data/loader';
import { SITE_TITLE } from '../consts';
import '../styles/illustration.scss';
import '../styles/bladebearer.scss';

// Auto-load ALL categories from CSV files - completely dynamic!
const allCategories = loadAllArtworkCollections();

const CATEGORIES = ['bladebearer']
  .map(key => allCategories.find(cat => cat.key === key))
  .filter(cat => cat !== undefined);
// Get category from URL params, default to first category
const url = new URL(Astro.request.url);
const categoryParam = url.searchParams.get('category');
const currentCategoryKey = categoryParam || CATEGORIES[0]?.key || 'animation';

// Find the current category config and get its artwork
const currentCategory = CATEGORIES.find(cat => cat.key === currentCategoryKey) || CATEGORIES[0];
const artwork = currentCategory?.artwork || [];

console.log('Available categories:', CATEGORIES.map(c => c.key));
console.log('Current category:', currentCategoryKey);
console.log('Artwork count:', artwork.length);
---

<BaseLayout title={`Blade Bearer - ${SITE_TITLE}`} description="">
  <div class="illustration-page">
    <div class="category-selector">
		<span class="category-option active gameplay">Gameplay</span>
		<!-- <span class="category-separator">•</span> -->
		<span class="category-option about">About</span>
		<!-- <span class="category-separator">•</span> -->
		<span class="category-option link"><a href="https://lukko-digital.itch.io/bladebearer-recarved" target="_blank">Game Jam</a></span>
		<!-- <span class="category-separator">•</span> -->
		<span class="category-option link"><a href="https://store.steampowered.com/app/3574540/Bladebearer_Recarved/" target="_blank">Wishlist</a></span>
    </div>

    <div class="slideshow-container active category-content gameplay">
      <SlideshowVariableLayout artwork={artwork} />
    </div>
    <div class="category-content about">
      <h1>
        Currently in development by
      </h1>
      <a href="https://lukko.digital" target="_blank">Lukko Digital</a>
      <h2>
        Ian Lum<br>
        Joshua Ehrlich<br>
        Miles Frank<br>
        Jonathan Han<br>
        Eli Smirin<br>
      </h2>
    </div>
  </div>
</BaseLayout>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    const categoryOptions = document.querySelectorAll('.category-option');

    let activeCategory = 'gameplay';
    
    for (let category_option of categoryOptions) {

      if (category_option.classList.contains('link')) {
        return;
      };

      category_option.addEventListener('click', () => {


        activeCategory = category_option.classList[category_option.classList.length - 1];
        console.log('Active category:', activeCategory);

        categoryOptions.forEach(option => {
          option.classList.remove('active');
        });
        category_option.classList.add('active');


        document.querySelectorAll('.category-content').forEach(content => {
          content.classList.remove('active');
        });
        const currentContent = document.querySelector(`.category-content.${activeCategory}`);
        if (currentContent) {
          currentContent.classList.add('active');
        }
        console.log('Current content:', currentContent);
      });
    }

  });
</script>
