---
import GalleryLayout from '../components/GalleryLayout.astro';
import { editorialArtwork } from '../data/editorial';

// Editorial gallery row configuration
const editorialRows = [
  {
    id: 'row2', 
    height: '300px',
    imageIds: ['exodus', 'pointing_gun'],
    flexShrink: [1, 1.2]
  },
  {
    id: 'row3',
    height: '400px',
    imageIds: ['p2', 'sketch_2'],
    flexShrink: [2, 1]
  },
  {
    id: 'row1',
    height: '450px',
    imageIds: ['giant'],
    flexShrink: [1]
  },
];
---

<GalleryLayout 
  title="Editorial"
  description="Editorial illustrations and narrative artwork"
  artwork={editorialArtwork}
  rows={editorialRows}
  imageFolder="illustration"
/>
