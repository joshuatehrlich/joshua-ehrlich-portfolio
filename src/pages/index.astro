---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { homepageArtwork } from '../data/index';
import '../styles/index.scss';

// Import all images from assets/index
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/index/*');

// Create a map of imagePath to actual imported image
const imageMap = new Map();
for (const [path, imageLoader] of Object.entries(images)) {
  const filename = path.split('/').pop();
  const image = await imageLoader();
  imageMap.set(filename, image.default);
}
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="autoscroll-gallery">
    <div class="slideshow-container">
      {homepageArtwork.map((artwork, index) => {
        const filename = artwork.imagePath.split('/').pop();
        const image = imageMap.get(filename);
        
        return (
          <div class={`gallery-slide ${index === 0 ? 'active' : ''}`}>
            <div class="image-container">
              <Image 
                src={image} 
                alt={artwork.title}
                class="gallery-image"
                loading="eager"
                quality={90}
              />
            </div>
            <div class="image-info">
              <p><span class="title">{artwork.title}</span> • {artwork.year}</p>
              {/* <p class="year-medium">{artwork.year} • {artwork.medium}</p>
              <p class="description">{artwork.description}</p> */}
            </div>
          </div>
        );
      })}
    </div>
    
    <!-- Slide indicators -->
    <div class="slide-indicators">
      {homepageArtwork.map((_, index) => (
        <div class={`indicator ${index === 0 ? 'active' : ''}`} data-slide={index}></div>
      ))}
    </div>
  </div>
</BaseLayout>

<script src="../scripts/slideshow.js"></script>
